# Copy to .env.local to point the app at a different Supabase project.
# Both values are public by design: access is controlled by row level security
# and the validated functions in supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
